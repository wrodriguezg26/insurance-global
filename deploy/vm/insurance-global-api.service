# /etc/systemd/system/insurance-global-api.service
[Unit]
Description=Insurance Global - API del servidor central
After=network-online.target
Wants=network-online.target

[Service]
User=insurance
Group=insurance
WorkingDirectory=/opt/insurance-global
EnvironmentFile=/etc/insurance-global.env
ExecStart=/usr/bin/node /opt/insurance-global/deploy/vm/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/insurance-global
# Carpeta privada y escribible para los archivos .json de cada registro (/var/lib/insurance-global)
StateDirectory=insurance-global
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
